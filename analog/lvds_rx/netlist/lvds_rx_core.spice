.subckt lvds_lane VDD VSS INP INN EN VBN VBP VB2 VREF OUT
xesdp INP gp VDD VSS lvds_esd2
xesdn INN gn VDD VSS lvds_esd2
xpre VDD VSS gp gn VBN VBP VB2 VREF oa ob lvds_pre
xhyst VDD VSS oa ob VBN EN d2a d2b lvds_hyst
xout VDD VSS d2a d2b EN OUT lvds_out
.ends lvds_lane

.subckt lvds_rx_x3 VDD VSS RX0_P RX0_N RX1_P RX1_N RX2_P RX2_N EN RX0_O RX1_O RX2_O
* unimplemented build flags must not be set: the resistor below, whose value is an undefined parameter, makes ngspice stop at parse time (an unknown subckt would fail even in a false .if)
.if (flag_extra_gain_stage != 0)
Rflag_extra_gain_stage_not_implemented 0 0 FLAG_extra_gain_stage_NOT_IMPLEMENTED_set_it_back_to_0
.endif
.if (flag_bias_constgm != 0)
Rflag_bias_constgm_not_implemented 0 0 FLAG_bias_constgm_NOT_IMPLEMENTED_set_it_back_to_0
.endif
.if (flag_failsafe != 0)
Rflag_failsafe_not_implemented 0 0 FLAG_failsafe_NOT_IMPLEMENTED_set_it_back_to_0
.endif
.if (flag_on_die_term != 0)
Rflag_on_die_term_not_implemented 0 0 FLAG_on_die_term_NOT_IMPLEMENTED_set_it_back_to_0
.endif
xbias VDD VSS EN vbn vbp vb2 vref lvds_bias
xl0 VDD VSS RX0_P RX0_N EN vbn vbp vb2 vref RX0_O lvds_lane
xl1 VDD VSS RX1_P RX1_N EN vbn vbp vb2 vref RX1_O lvds_lane
xl2 VDD VSS RX2_P RX2_N EN vbn vbp vb2 vref RX2_O lvds_lane
.ends lvds_rx_x3

