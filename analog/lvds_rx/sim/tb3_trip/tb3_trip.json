{
 "name": "tb3_trip",
 "description": "TB3: trip points VTH+, VTH-, hysteresis V_H and centre offset of lane 0 by one continuous DC sweep (up then down, or down then up), hysteresis on, 3 VIC; supply sensitivity from repeats at VDD 3.0 and 3.6 V",
 "deck": "tb3_trip.spice",
 "corners": "full45",
 "grid": {"vic": [0.05, 1.2, 2.35], "sweep": [0, 1]},
 "vars": {"wmax": 0.051},
 "post": "hooks.py:post_tb3",
 "limits": {
  "vh_v": {"min": 0.006, "max": 0.035, "scale": 1000, "unit": "mV"},
  "n_up": {"min": 1, "max": 1},
  "n_dn": {"min": 1, "max": 1}
 },
 "timeout": 300,
 "retry": {"timeout": 150, "variants": [
  {"name": "itl_gmin1e-10", "sub": [[".option rshunt=1e11", ".option rshunt=1e11 itl1=500 itl2=200 gmin=1e-10"]]},
  {"name": "gmin1e-9", "sub": [[".option rshunt=1e11", ".option rshunt=1e11 gmin=1e-9"]]}]},
 "jobs": 6
}
